FROM debian:bookworm-slim

ARG USER_UID=1000
ARG USER_GID=1000

# 환경변수 — 외부(호스트) Ollama 연결. OLLAMA_HOST 는 entrypoint 가 settings.json 에 반영
ENV LC_ALL=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive
ENV ANTHROPIC_BASE_URL=http://host.docker.internal:11434
ENV ANTHROPIC_AUTH_TOKEN=ollama
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Node.js 22 + tzdata (TZ 환경변수 적용용 zoneinfo)
RUN apt-get update && \
    apt-get install -y curl git netcat-traditional tzdata && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Claude Code 설치
RUN npm install -g @anthropic-ai/claude-code

# ubuntu 유저 생성 (UID/GID 가변, 기본 1000 — 호스트 사용자와 일치 권장)
RUN groupadd -g ${USER_GID} ubuntu && \
    useradd -m -u ${USER_UID} -g ${USER_GID} -s /bin/bash ubuntu

# ubuntu용 .claude 디렉토리 생성
RUN mkdir -p /home/ubuntu/.claude

# alias 설정 (시스템 전체)
RUN echo "alias cc='claude --dangerously-skip-permissions'" >> /etc/bash.bashrc

# ubuntu 홈 소유권 설정
RUN chown -R ubuntu:ubuntu /home/ubuntu

# 외부 Ollama 연결 대기 + settings.json 생성 스크립트
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# 기본 유저 (변경 가능: docker exec -u root ... 로 root 접근 가능)
USER ubuntu
WORKDIR /home/ubuntu

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["sleep", "infinity"]
