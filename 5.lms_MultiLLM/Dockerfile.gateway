# 5.lms_MultiLLM 게이트웨이 — nginx L7 패스스루 로드밸런서
#   B1 실증(변환 불요): claude CLI ↔ LMS OpenAI /v1 직결.
#   게이트웨이의 단일 책임 = 다중 LMS 백엔드로의 분산(로드밸런싱)뿐.
FROM nginx:1.27-bookworm

ENV DEBIAN_FRONTEND=noninteractive

# curl: 헬스체크(/v1/models) / tzdata: TZ 적용
RUN apt-get update && \
    apt-get install -y curl tzdata && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# nginx 공식 이미지 템플릿 메커니즘:
#   /etc/nginx/templates/*.template → (envsubst, 정의된 env 만 치환) → /etc/nginx/conf.d/
#   여기서는 ${LMS_PORT} 만 치환되고 nginx 의 $변수($host 등)는 보존됨.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

# [air-gap 대안] 폐쇄망이면 nginx 베이스 이미지도 docker export/import 파이프라인으로 반입
#   (외부망에서 'docker pull nginx:1.27-bookworm' 후 매체 반입). SSOT air-gap 절 참조.

EXPOSE 8080
